{
  "type": "object",
  "properties": {
    "schema": {
      "const": "aom04a.review-decision.v1"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "maintainer",
        "owner"
      ]
    },
    "candidate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[0-9a-f]{40}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "request_changes",
        "dismiss"
      ]
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "format": "date-time"
    },
    "source_receipt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "reviewer",
    "role",
    "candidate",
    "decision",
    "timestamp",
    "source_receipt"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-ops.org/process/review-decision.v1"
}
