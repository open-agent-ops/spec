{
  "$defs": {
    "digest": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
    "document_schema": {
      "additionalProperties": false,
      "properties": {
        "id": {"const": "https://agent-ops.ru/schemas/c4_lifecycle_event.schema.json"},
        "media_type": {"const": "application/schema+json"},
        "sha256": {"$ref": "#/$defs/digest"},
        "version": {"const": "1.0.0"}
      },
      "required": ["id", "version", "sha256", "media_type"],
      "type": "object"
    },
    "id": {"pattern": "^[a-z0-9][a-z0-9._-]{0,127}$", "type": "string"}
  },
  "$id": "https://agent-ops.ru/schemas/c4_lifecycle_event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_sequence": {"maximum": 16, "minimum": 1, "type": "integer"},
    "details_sha256": {"$ref": "#/$defs/digest"},
    "document_schema": {"$ref": "#/$defs/document_schema"},
    "event_id": {"$ref": "#/$defs/id"},
    "execution_id": {"$ref": "#/$defs/id"},
    "fence": {"minimum": 1, "type": "integer"},
    "format_version": {"const": "1.0.0"},
    "obligation_id": {"$ref": "#/$defs/id"},
    "occurred_at": {"format": "date-time", "type": "string"},
    "package_sha256": {"$ref": "#/$defs/digest"},
    "previous_event_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "profile_id": {"const": "agent-ops.c4-human-approved-apply@1.0.0"},
    "sequence": {"minimum": 1, "type": "integer"},
    "type": {"enum": ["package_created", "approval_bound", "human_started", "reservation_acquired", "attempt_admitted", "effect_observed", "outcome_classified", "obligation_opened", "obligation_resolved", "checkpoint_written", "terminal_released"]}
  },
  "required": ["format_version", "document_schema", "profile_id", "event_id", "sequence", "previous_event_sha256", "occurred_at", "type", "package_sha256", "details_sha256"],
  "title": "Agent-Ops C4 Immutable Lifecycle Event",
  "type": "object"
}
