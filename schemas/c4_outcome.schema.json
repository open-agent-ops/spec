{
  "$defs": {
    "digest": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
    "document_schema": {
      "additionalProperties": false,
      "properties": {
        "id": {"const": "https://agent-ops.ru/schemas/c4_outcome.schema.json"},
        "media_type": {"const": "application/schema+json"},
        "sha256": {"$ref": "#/$defs/digest"},
        "version": {"const": "1.0.0"}
      },
      "required": ["id", "version", "sha256", "media_type"],
      "type": "object"
    },
    "id": {"pattern": "^[a-z0-9][a-z0-9._-]{0,127}$", "type": "string"},
    "target": {
      "additionalProperties": false,
      "properties": {
        "generation": {"minimum": 1, "type": "integer"},
        "uid": {"$ref": "#/$defs/id"},
        "versions": {
          "additionalProperties": false,
          "properties": {
            "policy": {"$ref": "#/$defs/id"},
            "profile": {"$ref": "#/$defs/id"},
            "resource": {"$ref": "#/$defs/id"}
          },
          "required": ["resource", "policy", "profile"],
          "type": "object"
        }
      },
      "required": ["uid", "generation", "versions"],
      "type": "object"
    }
  },
  "$id": "https://agent-ops.ru/schemas/c4_outcome.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "completeness": {"enum": ["complete", "incomplete", "unknown"]},
    "document_schema": {"$ref": "#/$defs/document_schema"},
    "effect_state": {"enum": ["unknown", "applied", "not_applied", "partial"]},
    "evaluated_at": {"format": "date-time", "type": "string"},
    "evidence_fact_ids": {"items": {"$ref": "#/$defs/id"}, "maxItems": 64, "type": "array", "uniqueItems": true},
    "execution_id": {"$ref": "#/$defs/id"},
    "format_version": {"const": "1.0.0"},
    "intent_id": {"$ref": "#/$defs/id"},
    "open_obligation_ids": {"items": {"$ref": "#/$defs/id"}, "maxItems": 64, "type": "array", "uniqueItems": true},
    "outcome_check_ref": {"$ref": "#/$defs/id"},
    "outcome_check_sha256": {"$ref": "#/$defs/digest"},
    "outcome_id": {"$ref": "#/$defs/id"},
    "profile_id": {"const": "agent-ops.c4-human-approved-apply@1.0.0"},
    "state": {"enum": ["unknown", "succeeded", "failed"]},
    "target": {"$ref": "#/$defs/target"}
  },
  "required": ["format_version", "document_schema", "profile_id", "outcome_id", "intent_id", "execution_id", "target", "effect_state", "state", "completeness", "evidence_fact_ids", "outcome_check_ref", "outcome_check_sha256", "evaluated_at", "open_obligation_ids"],
  "title": "Agent-Ops C4 Outcome",
  "type": "object"
}
